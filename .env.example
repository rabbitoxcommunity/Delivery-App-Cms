# The backend API base URL, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Every FreshCart supermarket gets its own Admin build (§1.2/A1 of the
# backend design — one white-label app per tenant), so the tenant slug is
# fixed at build time rather than chosen at login. Find it via
# GET /platform/tenants as a super admin, or from your seed script's output.
VITE_TENANT_SLUG=freshcart-demo
